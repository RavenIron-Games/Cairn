<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the SDK actually installed here. RollForward=LatestMajor means this keeps
         running when the runtime moves on: the harness needs *a* modern runtime, not a
         specific one. -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <AssemblyName>CoreTests</AssemblyName>
    <RootNamespace>Cairn.Tests</RootNamespace>
    <!-- The mod targets net472 and needs Mono to run. These files' *logic* has no Unity
         dependency, so compiled against stubs they run on any modern .NET. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />

    <!--
      THE SHIPPING SOURCE, not a copy. A harness that duplicates the logic proves nothing
      about the logic that ships, and drifts apart from it silently.
    -->
    <Compile Include="..\..\Cairn\Core\LandmarkKey.cs" />
    <Compile Include="..\..\Cairn\Core\Landmark.cs" />
    <Compile Include="..\..\Cairn\Core\LandmarkStore.cs" />
    <Compile Include="..\..\Cairn\Core\SignReading.cs" />
    <Compile Include="..\..\Cairn\Core\PileDetection.cs" />
    <Compile Include="..\..\Cairn\Core\BeaconSelection.cs" />
    <Compile Include="..\..\Cairn\Core\DisplayText.cs" />
    <Compile Include="..\..\Cairn\Core\HexColour.cs" />
    <Compile Include="..\..\Cairn\Core\Persistence.cs" />
    <Compile Include="..\..\Cairn\Core\ConfigLedger.cs" />
    <Compile Include="..\..\Cairn\Config\ModConfig.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Config files a SHIPPED build really wrote, not hand-built ones: a fixture written by
         hand agrees with the parser that was written alongside it. -->
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
