<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Cairn</AssemblyName>
    <RootNamespace>RavenIron.Cairn</RootNamespace>
    <Version>0.8.0</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>Raven Iron</Company>
    <Product>Cairn</Product>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <!-- Keep the build machine's folders out of the shipped DLL. Without
         this the PE debug directory carries the absolute PDB path
         (C:\Users\<name>\...\obj\Release\Cairn.pdb), which exposes the
         Windows user name and makes the md5 depend on where the repo is
         checked out. The SDK maps each source root to /_/, /_1/, ... in the
         DLL, the PDB and the PDB's Source Link table alike. -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <!-- Always name the repo root as a source root for the mapping above.
         In a git checkout git adds the same root with its Source Link data
         and the two merge into one; without it (a source zip, a broken
         .git, git queries switched off) the folder would stay unmapped and
         its absolute path would go back into the DLL with no warning. -->
    <SourceRoot Include="$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))" />
  </ItemGroup>

  <!--
    Shared libs folder at the repo root, populated by tools\fetch-libs.ps1.
    Deliberately NOT a hardcoded Steam path: a second checkout lives somewhere else,
    and a Steam library move would break every clone.
    libs\ is gitignored - each dev runs fetch-libs once.
  -->
  <PropertyGroup>
    <LibsDir>$(MSBuildThisFileDirectory)..\libs</LibsDir>
  </PropertyGroup>

  <Target Name="CheckLibs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(LibsDir)\assembly_valheim_publicized.dll')"
           Text="libs\ is missing or empty. Run tools\fetch-libs.ps1 to populate it from your Valheim install." />
  </Target>

  <!--
    ONE source of truth for the version: the Version property above.

    BepInPlugin needs a compile-time constant, so the number has to exist in C# as well -
    and two copies of a number drift. Ragnarok's Wrath catches that drift at PACKAGE time,
    which is late: a test build can still be deployed with a stale version in its boot line,
    and on 2026-09-02 five different builds all announced themselves as v0.1.0 while a live
    diagnosis depended on knowing which one was running.

    Generating the constant means the two can never disagree, rather than being checked.
  -->
  <Target Name="GenerateVersionConst" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <VersionConstFile>$(IntermediateOutputPath)BuildVersion.g.cs</VersionConstFile>
    </PropertyGroup>
    <WriteLinesToFile
        File="$(VersionConstFile)"
        Lines="// Generated from the csproj Version property. Do not edit.%0Anamespace RavenIron.Cairn%0A{%0A    internal static class BuildVersion%0A    {%0A        public const string Value = &quot;$(Version)&quot;%3B%0A    }%0A}"
        Overwrite="true"
        WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(VersionConstFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!--
      Include names are the assemblies' real identities: the publicized files still
      identify as assembly_valheim / assembly_utils, so naming them '..._publicized'
      resolves through HintPath but warns on identity mismatch.
    -->
    <Reference Include="assembly_valheim">
      <HintPath>$(LibsDir)\assembly_valheim_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(LibsDir)\assembly_utils_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(LibsDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Physics: the beacon raycasts terrain so a light can be hidden by a ridge. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(LibsDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(LibsDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BepInEx">
      <HintPath>$(LibsDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(LibsDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
